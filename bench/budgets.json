{
  "$schema": "../node_modules/@cosyte/bench/schema/budgets-v1.schema.json",
  "schemaVersion": 1,
  "kind": "budgets",
  "description": "The limits @cosyte/dicom holds its build to, judged by cosyte-bench gate in the Budgets workflow on every pull request. Peak: 20 times one input for a dense shape (the worklist item and the SR), 3 times for the CT shapes, whose bytes are almost all Pixel Data; a case still over its multiple has no peak limit and is listed with its gap in AGENTS.md, under Benchmarks. Allocation and throughput: the first floor's limits (its highest A/A reading plus three spreads), rounded to two significant figures, allocation up and throughput down; at a benchmark's largest size the throughput is also held to half its smallest size's slowest A/A reading. serializeDicom: CT @ 20 frames, 10 MiB has no throughput limit: one A/A reading skipped its throughput. Import: a median cold import of at most 15 ms, and the first floor's gzipped bytes rounded up to two significant figures.",
  "rules": [
    {
      "benchmark": "parseDicom: worklist item",
      "size": "1 KiB",
      "peakMultiple": {
        "small": 20
      },
      "allocBytesPerOp": 12000,
      "minBytesPerSecond": 36000000
    },
    {
      "benchmark": "parseDicom, then read tags: worklist item",
      "size": "1 KiB",
      "allocBytesPerOp": 38000,
      "minBytesPerSecond": 12000000
    },
    {
      "benchmark": "serializeDicom: worklist item",
      "size": "1 KiB",
      "peakMultiple": {
        "small": 20
      },
      "allocBytesPerOp": 12000,
      "minBytesPerSecond": 39000000
    },
    {
      "benchmark": "parseDicom: CT",
      "size": "single frame, 514 KiB",
      "peakMultiple": {
        "medium": 3
      },
      "allocBytesPerOp": 62000,
      "minBytesPerSecond": 8400000000
    },
    {
      "benchmark": "parseDicom: CT",
      "size": "20 frames, 10 MiB",
      "peakMultiple": {
        "large": 3
      },
      "allocBytesPerOp": 130000,
      "minBytesPerSecond": 47000000000
    },
    {
      "benchmark": "parseDicom: CT",
      "size": "200 frames, 100 MiB",
