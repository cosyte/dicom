{
  "name": "@cosyte/dicom",
  "version": "0.1.11",
  "description": "DICOM Part 10 parser + utility library for Node.js and TypeScript: metadata-first, vendor-quirky-tolerant, dual ESM/CJS.",
  "keywords": [
    "dicom",
    "dicom-part-10",
    "medical-imaging",
    "radiology",
    "pacs",
    "ct",
    "mri",
    "metadata",
    "de-identification",
    "anonymization",
    "healthcare",
    "interoperability",
    "parser",
    "serializer",
    "typescript"
  ],
  "homepage": "https://docs.cosyte.com/dicom",
  "bugs": {
    "url": "https://github.com/cosyte/dicom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/dicom.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "postcss@>=8.0.0 <8.5.23": "8.5.23"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "clean": "rm -rf dist coverage",
    "typecheck": "cosyte-process typecheck",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench:reading": "cosyte-bench run --suite bench/dicom.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/dicom.bench.mjs",
    "bench:profile": "node --enable-source-maps bench/profile.mjs dist/index.mjs",
    "fuzz": "vitest run test/property/fuzz.property.test.ts test/property/corpus-fuzz.property.test.ts test/property/values-fuzz.property.test.ts",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "node scripts/process-tool.mjs eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts examples/data/*.ts",
    "gen:dictionary": "tsx scripts/generate-dictionary.ts",
    "gen:annex-e": "tsx scripts/generate-annex-e.ts",
    "gen:repeating-groups": "tsx scripts/generate-repeating-groups.ts",
    "gen:encapsulated-transfer-syntaxes": "tsx scripts/generate-encapsulated-transfer-syntaxes.ts",
    "gen:clean": "find src/dictionary/generated -mindepth 1 ! -name 'README.md' -delete",
    "gen:all": "pnpm gen:repeating-groups && pnpm gen:dictionary && pnpm gen:annex-e && pnpm gen:encapsulated-transfer-syntaxes",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:process": "cosyte-process check",
    "measure:phi-scan-unread": "tsx scripts/measure-phi-scan-unread.ts",
    "measure:phi-scan-retention": "node scripts/measure-phi-scan-retention.ts",
    "measure:phi-scan-monotonicity": "node scripts/measure-phi-scan-monotonicity.ts",
    "measure:phi-scan-regex-statics": "node scripts/measure-phi-scan-regex-statics.ts",
    "measure:phi-scan-line-endings": "node scripts/measure-phi-scan-line-endings.ts",
    "measure:phi-scan-html-blocks": "node scripts/measure-phi-scan-html-blocks.ts",
    "measure:phi-scan-atx-heading": "node scripts/measure-phi-scan-atx-heading.ts",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "smoke": "tsx scripts/smoke.ts",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && node scripts/sync-version.mjs && prettier --write package.json src/version.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm gen:all && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.8",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "^22.20.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  }
}
